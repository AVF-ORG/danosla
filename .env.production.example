# Copy this to ".env" on the EC2 box and fill in every <PLACEHOLDER>.
# Never commit the real .env file.
#
# This template targets the end state (real domain + HTTPS via default.prod.conf).
# The server currently deployed at 13.53.241.191 runs a temporary HTTP/IP-only
# variant instead (REVERB_*/VITE_REVERB_* pointed at the IP on port 80, APP_URL
# http://13.53.241.191) — see docs/DEPLOY_AWS.md's "Already deployed" section.
# Switch to this template's domain-based values once you point a domain at the
# Elastic IP and follow DEPLOY_AWS.md step 8.

APP_NAME=Danosla
APP_ENV=production
APP_KEY=                      # fill in after: docker compose -f docker-compose.prod.yml run --rm app php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://YOUR_DOMAIN

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

# ── RDS (managed MySQL) ───────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=danosla-db.cv6cosowyif2.eu-north-1.rds.amazonaws.com
DB_PORT=3306
DB_DATABASE=danosla_db
DB_USERNAME=danosla_app
DB_PASSWORD=<strong-password>
# ^ create this app-scoped user first (see docs/DEPLOY_AWS.md step 2) instead of using the "admin" master user

# ── ElastiCache (managed Redis) ───────────────────────────────────────────
REDIS_HOST=danosla-redis.w8yhhi.ng.0001.eun1.cache.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=10080
QUEUE_CONNECTION=redis

# ── Reverb (proxied through nginx at /app, see docker/nginx/default.prod.conf) ──
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=<generate-random-id>
REVERB_APP_KEY=<generate-random-key>
REVERB_APP_SECRET=<generate-random-secret>
REVERB_HOST=YOUR_DOMAIN
REVERB_PORT=443
REVERB_SCHEME=https

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=YOUR_DOMAIN
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# ── Mail (SES recommended once you're on AWS) ─────────────────────────────
MAIL_MAILER=ses
MAIL_FROM_ADDRESS="no-reply@YOUR_DOMAIN"
MAIL_FROM_NAME="${APP_NAME}"

# ── S3 (optional, recommended for uploaded files so they survive redeploys) ─
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=<iam-user-access-key>
AWS_SECRET_ACCESS_KEY=<iam-user-secret-key>
AWS_DEFAULT_REGION=eu-north-1
AWS_BUCKET=<your-s3-bucket-name>
AWS_USE_PATH_STYLE_ENDPOINT=false
